{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM gateway",
      "options": { "baseURL": "{env:LLM_GATEWAY_URL}/v1", "apiKey": "{env:LLM_GATEWAY_KEY}" },
      "models": {
        "fast":   { "name": "fast",   "limit": { "context": 200000, "output": 8000 } },
        "code":   { "name": "code",   "limit": { "context": 200000, "output": 8000 } },
        "reason": { "name": "reason", "limit": { "context": 200000, "output": 8000 } }
      }
    }
  },
  "model": "gateway/code",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/workspaces/**": "allow",
      "/knowledge/handbook/**": "allow",
      "/tmp/agent/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -a*": "allow",
      "git branch --show-current*": "allow",
      "git branch -vv*": "allow",
      "git remote -v*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git ls-remote*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git fetch*": "allow",
      "git describe*": "allow",
      "git merge-base*": "allow",
      "git shortlog*": "allow",
      "git worktree list*": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git switch -c*": "allow",
      "git checkout -b*": "allow",
      "git switch*": "allow",
      "git add*": "allow",
      "git commit -m*": "allow",
      "git commit -F*": "allow",
      "git pull --ff-only*": "allow",
      "git worktree add /tmp/agent/*": "allow",
      "git worktree remove /tmp/agent/*": "allow",
      "git push -u origin*": "allow",
      "git push origin*": "allow",
      "gh repo view*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh pr create*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh release list*": "allow",
      "gh auth status*": "allow",
      "wc*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "jq*": "allow",
      "ls*": "allow",
      "find*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "cat*": "allow",
      "git reset*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git checkout --*": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git commit --amend*": "ask",
      "git stash*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",
      "git tag*": "ask",
      "git remote add*": "ask",
      "git remote set-url*": "ask",
      "git config --global*": "ask",
      "git config user*": "ask",
      "git submodule*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh api*": "ask",
      "gh repo edit*": "ask",
      "gh secret*": "ask",
      "gh workflow run*": "ask",
      "rm *": "ask",
      "sudo *": "ask",
      "docker *": "ask",
      "sleep ??*": "ask",
      "kubectl get secret *": "ask",
      "kubectl get secrets *": "ask",
      "kubectl * get secret *": "ask",
      "kubectl * get secrets *": "ask",
      "*kustomize build*": "ask",
      "kubectl apply *": "ask",
      "kubectl * apply *": "ask",
      "kubectl create *": "ask",
      "kubectl * create *": "ask",
      "kubectl delete *": "ask",
      "kubectl * delete *": "ask",
      "kubectl patch *": "ask",
      "kubectl * patch *": "ask",
      "kubectl edit *": "ask",
      "kubectl * edit *": "ask",
      "kubectl replace *": "ask",
      "kubectl * replace *": "ask",
      "kubectl scale *": "ask",
      "kubectl * scale *": "ask",
      "kubectl rollout restart *": "ask",
      "kubectl * rollout restart *": "ask",
      "kubectl run *": "ask",
      "kubectl * run *": "ask",
      "kubectl label *": "ask",
      "kubectl * label *": "ask",
      "kubectl annotate *": "ask",
      "kubectl * annotate *": "ask",
      "kubectl cordon *": "ask",
      "kubectl uncordon *": "ask",
      "kubectl drain *": "ask",
      "kubectl set *": "ask",
      "kubectl * set *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git rebase origin/main*": "allow",
      "git stash list*": "allow",
      "git push --force-with-lease*": "ask",
      "rm -rf /tmp/agent/*": "allow",
      "docker manifest inspect *": "allow",
      "docker buildx imagetools inspect *": "allow",
      "kubectl -n argocd annotate application * argocd.argoproj.io/refresh=*": "allow",
      "rm * *..*": "ask",
      "git push*main*": "deny",
      "git push*HEAD:main*": "deny",
      "*--admin*": "deny",
      "*--no-verify*": "deny",
      "git rebase -i*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "*.env*": "deny",
      "*tfvars*": "deny",
      "*kubeconfig*": "deny",
      "*.kube/config*": "deny",
      "*sops-age*": "deny",
      "*keys.txt*": "deny",
      "*id_ed25519*": "deny",
      "*id_rsa*": "deny",
      "*sops -d*": "deny",
      "*sops --decrypt*": "deny",
      "*ksops*": "deny",
      "sops *": "deny",
      "sops decrypt *": "deny",
      "sops -d *": "deny",
      "sops --decrypt *": "deny",
      "gh auth token*": "deny",
      "env": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "printenv GH_TOKEN*": "deny",
      "echo *GH_TOKEN*": "deny",
      "kubectl exec*": "deny",
      "kubectl * exec *": "deny",
      "kubectl cp*": "deny",
      "kubectl -n hermes exec deploy/hermes -c hermes -- hermes skills list*": "ask",
      "kubectl -n hermes exec deploy/hermes -c hermes -- hermes cron list*": "ask",
      "kubectl -n hermes exec deploy/hermes -c hermes -- hermes mcp list*": "ask",
      "kubectl -n hermes exec deploy/hermes -c hermes -- hermes --help*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.tfvars": "deny",
      "*/.kube/config": "deny",
      "*/k3s.yaml": "deny",
      "*keys.txt": "deny",
      "*/.sops-age/*": "deny",
      "~/.config/gh/**": "deny",
      "**/hosts.yml": "deny",
      "bootstrap/versions.env": "allow"
    }
  },
  "mcp": {
    "open-knowledge": {
      "type": "local",
      "enabled": true,
      "command": ["ok", "mcp"]
    }
  }
}
